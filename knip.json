{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "shared/config/config.template.ts"
  ],
  "workspaces": {
    "backend": {
      "entry": [
        "scripts/*.ts",
        "emails/index.ts",
        "emails/preview-route.ts",
        "tests/**/*.ts"
      ]
    },
    "bench": {
      "ignoreDependencies": [
        "artillery",
        "artillery-plugin-ensure"
      ]
    },
    "shared": {
      "ignoreDependencies": [
        "pino-opentelemetry-transport"
      ]
    },
    "infra": {
      "entry": [
        "index.ts",
        "tasks/*.ts"
      ]
    }
  }
}
