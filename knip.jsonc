{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // `@testSeam`: a test loads it through `vi.importActual`, which knip cannot resolve. `@sideEffect`: the
  // export exists because constructing it does the work (a Pulumi resource), so nothing ever reads the name.
  "tags": ["-testSeam", "-sideEffect"],
  "workspaces": {
    ".": {
      // `pnpm cella align --run` runs each alignment's codemod by path, and `pnpm cella a11y` and `pnpm cella screenshots`
      // load their adapters by path, so nothing imports them.
      "entry": [
        "cella/cella.config.ts",
        "cella/a11y*.ts",
        "cella/screenshots*.ts",
        "cella/skills/**/*.mjs",
        "cella/alignments/*/*.ts"
      ],
      // The CLI runs codemods and loads the adapters with the root's tsx.
      "ignoreDependencies": ["tsx"]
    },
    "backend": {
      // The drizzle plugin makes every `*-db.ts` an entry, and knip reports no unused export of an entry. Off, the files
      // are checked like any other: tables are imported through `src/tables.ts`, and an export only drizzle-kit reads
      // takes `@public`.
      "drizzle": false,
      "entry": [
        "drizzle.config.ts",
        // Loaded by readdir in scripts/scripts-discovery.ts.
        "scripts/migrations/*.migration.ts",
        "scripts/seeds/*.seed.ts",
        "emails/index.ts",
        "emails/preview-route.ts",
        "tests/**/*.ts",
        // Unused by cella itself; apps import it to derive search keywords from descriptions.
        "src/utils/extract-keywords.ts",
        // Opt-in draft lifecycle: no cella table declares `publishedAt`, apps add the column with this helper.
        "src/db/utils/published-column.ts",
        // `pnpm cella bench` runs bench/run.ts, which imports every scenarios/*.ts; data-setup imports every *.bench.ts.
        "bench/run.ts",
        "bench/scenarios/*.ts",
        "bench/seeds/*.bench.ts"
      ],
      // The service image installs only `dependencies` (shared/src/keep-on-disk.ts). shared/src imports these, and the
      // bundle loads them from disk or by name (pino transports), so they are listed here without an import in this workspace.
      "ignoreDependencies": ["@opentelemetry/.+", "^pino(-.+)?$"],
      // `pnpm tunnel` runs the ngrok CLI, installed with `brew install ngrok`.
      "ignoreBinaries": ["ngrok"]
    },
    "cdc": {
      "entry": ["src/**/*.type-check.ts"],
      "ignoreDependencies": ["@opentelemetry/.+", "^pino(-.+)?$"]
    },
    "frontend": {
      // Unused here, imported by the apps: no import in cella is no reason to delete one of these.
      // board-layout.tsx also keeps board-drag.ts and resizable-panels.tsx reachable.
      "entry": [
        // The root `generate:routes` runs it across the workspace boundary, which knip cannot follow.
        "vite/generate-routes.ts",
        // Vendored shadcn chart, kept whole for an app that wants it: its own story carries the rest,
        // and nothing in cella renders the legend parts yet.
        "src/modules/ui/chart.tsx",
        "src/modules/common/board/board-layout.tsx",
        "src/modules/common/board/board-panel.tsx",
        "src/modules/common/board/panel-drag-handle-button.tsx",
        "src/modules/common/date-tooltip.tsx",
        "src/modules/common/dropdowner/dropdown-segmented.tsx",
        "src/modules/common/dropdowner/dropdown-select-item.tsx",
        "src/modules/common/form-fields/select-combobox/parent.tsx",
        "src/modules/common/list-skeleton.tsx",
        "src/modules/common/page/local-tab-nav.tsx",
        "src/modules/entities/entity-grid/view-mode.ts",
        "src/modules/marketing/about/faq.tsx",
        "src/hooks/use-organization-layout-context.ts",
        "src/utils/clean-url.ts",
        "src/utils/date-full.ts",
        "src/utils/is-in-range.ts",
        "src/utils/stable-array.ts",
        // vite.config.ts aliases jspdf's optional packages to it.
        "vite/jspdf-optional-stub.ts",
        // The service worker, which @serwist/vite builds from vite.config.ts.
        "src/lib/sw.ts"
      ],
      // vite.config.ts aliases `#pdfjs` to react-pdf's own pdfjs-dist, which react-pdf pins exactly, so the app lists no copy.
      "ignoreDependencies": ["pdfjs-dist"]
    },
    "infra": {
      "entry": ["index.ts", "tasks/*.ts", "agent/src/entry.ts"]
    },
    "shared": {
      // pino resolves transport targets by name.
      "ignoreDependencies": ["pino-pretty"]
    },
    "yjs": {
      "entry": ["src/tests/integration/global-setup.ts"],
      "ignoreDependencies": ["@opentelemetry/.+", "^pino(-.+)?$"]
    }
  }
}
