{
  "name": "shared",
  "description": "Shared config, permissions, types, and cross-package utilities",
  "type": "module",
  "scripts": {
    "ts": "cd .. && tsgo -p shared/tsconfig.json --pretty",
    "tsperf": "rm -rf tsconfig.tsbuildinfo && tsgo --noEmit --extendedDiagnostics",
    "lens:check": "tsx scripts/check-lenses.ts",
    "test": "vitest run"
  },
  "exports": {
    ".": "./index.ts",
    "./*": "./src/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./cli-utils/*": "./src/cli-utils/*.ts",
    "./testing/*": "./src/testing/*.ts",
    "./blocknote": "./src/utils/text-from-block.ts",
    "./health-app": "./src/health-app.ts",
    "./transloadit-config": "./config/transloadit-config.ts"
  },
  "dependencies": {
    "@blocknote/core": "^0.54.0",
    "@dotenv-run/core": "^1.3.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dobajs": "0.1.0",
    "hono": "^4.13.2",
    "nanoid": "^6.0.1",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "strip-json-comments": "^5.0.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
