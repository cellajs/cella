{
  "name": "shared",
  "description": "Shared config, permissions, types, and cross-package utilities",
  "type": "module",
  "scripts": {
    "ts": "cd .. && tsgo -p shared/tsconfig.json --pretty",
    "tsperf": "rm -rf tsconfig.tsbuildinfo && tsgo --noEmit --extendedDiagnostics",
    "lens:check": "tsx scripts/check-lenses.ts",
    "test": "vitest run"
  },
  "exports": {
    ".": "./index.ts",
    "./*": "./src/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./cli-utils/*": "./src/cli-utils/*.ts",
    "./testing/*": "./src/testing/*.ts",
    "./blocknote": "./src/utils/text-from-block.ts",
    "./health-app": "./src/health-app.ts",
    "./transloadit-config": "./config/transloadit-config.ts",
    "./config/*": "./config/*.ts"
  },
  "dependencies": {
    "@blocknote/core": "^0.56.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dobajs": "0.1.0",
    "hono": "^4.13.14",
    "nanoid": "^6.0.2",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "pino-abstract-transport": "^3.0.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
