# Show debug logs in console and in UI
VITE_DEBUG=true

# Enable i18n debug
VITE_DEBUG_I18N=false

# Report this browser's errors and sessions in development and tunnel to a receiver you run, as a Sentry envelope DSN:
# http://<public key>@localhost:<port>/<project id>. Empty: the mode's config names the DSN (monitoring.dsn), if any.
VITE_MONITORING_DSN=
