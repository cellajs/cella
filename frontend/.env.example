# Show debug logs in console and in UI
VITE_DEBUG=true

# Enable i18n debug
VITE_DEBUG_I18N=false

# Report this browser's errors and sessions in development to a receiver you run, as a Sentry envelope DSN:
# http://<public key>@localhost:<port>/<project id>. Empty: nothing is sent. A deployed mode names its DSN in its config.
VITE_MONITORING_DSN=
