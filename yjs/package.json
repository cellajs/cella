{
  "name": "yjs-worker",
  "version": "0.0.1",
  "description": "Yjs WebSocket relay for collaborative editing and document persistence",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "node --no-experimental-webstorage dist/yjs-worker.js",
    "start:dev": "cross-env NODE_OPTIONS=--no-experimental-webstorage tsx src/yjs-worker.ts",
    "dev": "cross-env NODE_ENV=development tsx --no-experimental-webstorage --env-file=../backend/.env --watch src/yjs-worker.ts",
    "build": "cross-env NODE_ENV=production rolldown -c",
    "ts": "tsgo --pretty",
    "tsperf": "rm -rf tsconfig.tsbuildinfo && tsgo --noEmit --extendedDiagnostics",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-abstract-transport": "^3.0.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cross-env": "^10.1.0",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.13",
    "lib0": "^0.2.119",
    "pino-pretty": "^13.2.0",
    "rate-limiter-flexible": "^11.2.3",
    "rolldown": "~1.2.15",
    "shared": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  }
}
