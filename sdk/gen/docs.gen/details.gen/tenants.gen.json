    "responses": [
      {
        "status": 200,
        "description": "Tenants list",
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "required": true,
              "itemType": "object",
              "ref": "#/components/schemas/Tenant",
              "items": {
                "type": "object",
                "description": "A tenant representing an isolated data partition for multi-tenancy.",
                "properties": {
                  "id": { "type": "string", "required": true, "maxLength": 24 },
                  "name": { "type": "string", "required": true, "maxLength": 255 },
                  "status": {
                    "type": "string",
                    "required": true,
                    "enum": ["active", "suspended", "archived"]
                  },
                  "restrictions": {
                    "type": "object",
                    "required": true,
                    "properties": {
                      "quotas": {
                        "type": "object",
                        "required": true,
                        "description": "Entity quotas (0 = unlimited)",
                        "additionalProperties": { "type": "integer", "required": false, "minimum": 0 }
                      },
                      "rateLimits": {
                        "type": "object",
                        "required": true,
                        "properties": {
                          "apiPointsPerHour": {
                            "type": "integer",
                            "required": true,
                            "description": "Max API points per hour per user within this tenant (0 = no tenant limit; the global safety ceiling still applies)",
                            "minimum": 0
                          }
                        }
                      },
                      "allowUnregisteredClients": {
                        "type": "boolean",
                        "required": true,
                        "description": "Whether members may consent to OAuth clients that have no registration (AI clients using a Client ID Metadata Document)"
                      }
                    }
                  },
                  "authStrategies": {
                    "type": "array",
                    "required": true,
                    "itemType": "string",
                    "enum": ["github", "google", "microsoft", "passkey", "totp", "email", "magic"]
                  },
                  "createdBy": {
                    "type": ["string", "null"],
                    "required": true,
                    "format": "uuid"
                  },
                  "subscriptionId": {
                    "type": ["string", "null"],
                    "required": true,
                    "maxLength": 255
                  },
                  "subscriptionStatus": {
                    "type": "string",
                    "required": true,
                    "enum": ["none", "trialing", "active", "past_due", "paused", "canceled"]
                  },
                  "subscriptionPlan": {
                    "type": ["string", "null"],
                    "required": true,
                    "maxLength": 255
                  },
                  "createdAt": { "type": "string", "required": true },
                  "updatedAt": {
                    "type": ["string", "null"],
                    "required": true
                  },
                  "domainsCount": { "type": "integer", "required": true, "description": "Number of domains claimed by this tenant" },
                  "organization": {
                    "type": ["object", "null"],
                    "required": true,
                    "description": "The organization this tenant holds, or null if none",
                    "properties": {
                      "id": { "type": "string", "required": true },
                      "name": { "type": "string", "required": true },
                      "slug": { "type": "string", "required": true },
                      "thumbnailUrl": {
                        "type": ["string", "null"],
                        "required": true
                      },
                      "entityType": {
                        "type": "string",
                        "required": true,
                        "enum": ["organization"]
                      }
                    }
                  }
                },
                "ref": "#/components/schemas/Tenant"
              }
            },
            "total": { "type": "number", "required": true }
          },
          "contentType": "application/json"
        },
