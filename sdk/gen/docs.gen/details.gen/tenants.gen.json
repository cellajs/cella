  {
    "operationId": "getTenants",
    "responses": [
      {
        "status": 200,
        "description": "Tenants list",
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "required": true,
              "itemType": "object",
              "ref": "#/components/schemas/Tenant",
              "items": {
                "type": "object",
                "description": "The top-level isolation and billing boundary. Tenant and organization are 1:1: a tenant holds one organization, or none until that organization is created. System admins list and update tenants; a signed-in user can create one of their own.",
                "properties": {
                  "id": { "type": "string", "required": true, "maxLength": 24 },
                  "name": { "type": "string", "required": true, "maxLength": 255 },
                  "status": {
                    "type": "string",
                    "required": true,
                    "enum": ["active", "suspended", "archived"]
                  },
                  "restrictions": {
                    "type": "object",
                    "required": true,
                    "properties": {
                      "quotas": {
                        "type": "object",
                        "required": true,
                        "description": "Entity quotas (0 = unlimited)",
                        "additionalProperties": { "type": "integer", "required": false, "minimum": 0 }
                      },
                      "rateLimits": {
                        "type": "object",
                        "required": true,
                        "properties": {
                          "apiPointsPerHour": {
                            "type": "integer",
                            "required": true,
                            "description": "Max API points per hour per user within this tenant (0 = no tenant limit; the global safety ceiling still applies)",
                            "minimum": 0
                          }
                        }
                      },
                      "allowUnregisteredClients": {
                        "type": "boolean",
                        "required": true,
                        "description": "Whether members may consent to OAuth clients that have no registration (AI clients using a Client ID Metadata Document)"
                      }
                    }
                  },
                  "authStrategies": {
                    "type": "array",
                    "required": true,
                    "itemType": "string",
                    "enum": ["github", "google", "microsoft", "passkey", "totp", "email", "magic", "surfconext"]
                  },
                  "subscriptionId": {
                    "type": ["string", "null"],
                    "required": true,
                    "maxLength": 255
                  },
                  "subscriptionStatus": {
                    "type": "string",
                    "required": true,
                    "enum": ["none", "trialing", "active", "past_due", "paused", "canceled"]
                  },
                  "subscriptionPlan": {
                    "type": ["string", "null"],
                    "required": true,
                    "maxLength": 255
                  },
                  "createdAt": { "type": "string", "required": true },
                  "createdBy": {
                    "type": ["object", "null"],
                    "required": true,
                    "ref": "#/components/schemas/ActorRef",
                    "refDescription": "Who wrote a row: a user or a service account, with the id, kind, name and avatar a cell renders. Embedded wherever a row names its writer, as `createdBy`, `updatedBy` and `deletedBy`; null once the actor is gone."
                  },
                  "updatedAt": {
                    "type": ["string", "null"],
                    "required": true
                  },
                  "updatedBy": {
                    "type": ["object", "null"],
                    "required": true,
                    "ref": "#/components/schemas/ActorRef",
                    "refDescription": "Who wrote a row: a user or a service account, with the id, kind, name and avatar a cell renders. Embedded wherever a row names its writer, as `createdBy`, `updatedBy` and `deletedBy`; null once the actor is gone."
                  },
                  "organization": {
                    "type": ["object", "null"],
                    "required": true,
                    "description": "The organization this tenant holds, or null if none",
                    "properties": {
                      "id": { "type": "string", "required": true },
                      "name": { "type": "string", "required": true },
                      "slug": { "type": "string", "required": true },
                      "thumbnailUrl": {
                        "type": ["string", "null"],
                        "required": true
                      },
                      "entityType": {
                        "type": "string",
                        "required": true,
                        "enum": ["organization"]
                      }
                    }
                  }
                },
                "ref": "#/components/schemas/Tenant"
              }
            },
            "total": { "type": "number", "required": true }
          },
          "contentType": "application/json"
        },
