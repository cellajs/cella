[
  {
    "operationId": "getConnections",
    "responses": [
      {
        "status": 200,
        "description": "Connections",
        "contentType": "application/json",
        "schema": {
          "type": "array",
          "itemType": "object",
          "ref": "#/components/schemas/Connection",
          "items": {
            "type": "object",
            "description": "A tenant's trust in an external party that asserts user identities: an institution reached through an SSO federation, whose members sign in to the tenant's organization. Its id is the public key of the tenant's SSO entry page. System admins manage connections per tenant; `pending` until the institution activated the service at the federation.",
            "properties": {
              "id": { "type": "string", "required": true, "format": "uuid" },
              "tenantId": { "type": "string", "required": true, "maxLength": 24 },
              "kind": {
                "type": "string",
                "required": true,
                "enum": ["sso", "lti"]
              },
              "issuer": { "type": "string", "required": true, "maxLength": 255 },
              "clientId": {
                "type": ["string", "null"],
                "required": true,
                "maxLength": 255
              },
              "deploymentId": {
                "type": ["string", "null"],
                "required": true,
                "maxLength": 255
              },
              "claimValues": { "type": "array", "required": true, "itemType": "string" },
              "displayName": { "type": "string", "required": true, "maxLength": 255 },
              "status": {
                "type": "string",
                "required": true,
                "enum": ["pending", "active", "disabled"]
              },
              "jitProvisioning": { "type": "boolean", "required": true },
              "config": {
                "type": "object",
                "required": true,
                "properties": {
                  "idpEntityIds": {
                    "type": "array",
                    "required": false,
                    "description": "The institution's IdP entity ids, passed as login_hint",
                    "itemType": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "logoUrl": {
                    "type": "string",
                    "required": false,
                    "description": "The institution's logo, for the entry page",
                    "format": "uri",
                    "maxLength": 255
                  }
                }
              },
              "createdBy": {
                "type": ["string", "null"],
                "required": true,
                "format": "uuid"
              },
              "createdAt": { "type": "string", "required": true },
              "updatedAt": {
                "type": ["string", "null"],
                "required": true
              }
            },
            "ref": "#/components/schemas/Connection"
          },
          "contentType": "application/json"
        },
        "example": [
          {
            "id": "920c1ebd-e058-4d64-bb56-872875fd1102",
            "tenantId": "gc9llm",
            "kind": "sso",
            "issuer": "surfconext",
            "clientId": null,
            "deploymentId": null,
            "claimValues": ["uu.nl"],
            "displayName": "Utrecht University",
            "status": "active",
            "jitProvisioning": true,
            "config": {
              "idpEntityIds": ["https://login.uu.nl/nidp/saml2/metadata"]
            },
            "createdBy": "3a1733e5-db1b-4f23-a822-aff57488fb99",
