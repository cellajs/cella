        "name": "TooManyRequestsError",
        "ref": "#/components/responses/TooManyRequestsError",
        "contentType": "application/json"
      }
    ],
    "request": {
      "path": {
        "properties": {
          "tenantId": { "type": "string", "required": true, "maxLength": 50 }
        }
