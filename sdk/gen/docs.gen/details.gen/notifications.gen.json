            "maxItems": 200,
            "itemType": "string",
            "maxLength": 50
          },
          "contextId": {
            "type": "string",
            "required": false,
            "description": "Mark everything sharing one context read",
            "maxLength": 50
          }
        },
        "required": true,
        "contentType": "application/json"
      }
    }
