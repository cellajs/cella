{
  "name": "infra",
  "description": "Pulumi IaC for Scaleway infrastructure and Kubernetes workloads",
  "type": "module",
  "scripts": {
    "cli": "tsx cli/infra-cli.ts",
    "test": "vitest run",
    "test:integration": "INTEGRATION=1 vitest run tests/integration",
    "ensure-state-bucket": "tsx tasks/ensure-state-bucket.ts",
    "sync-rollout-config": "tsx tasks/sync-rollout-config.ts",
    "forget-retired-resources": "tsx tasks/forget-retired-resources.ts",
    "deploy": "tsx tasks/deploy.ts",
    "main-job": "tsx tasks/main-job.ts",
    "status": "tsx tasks/status.ts",
    "preflight": "tsx tasks/preflight-privileged.ts",
    "repair-certs": "tsx tasks/repair-certs.ts",
    "boot:build": "rm -rf boot/dist && tsc --noEmit -p boot/tsconfig.json && rolldown boot/src/entry.ts --format cjs --platform node --file boot/dist/entry.cjs",
    "boot:image": "pnpm run boot:build && docker build --build-arg NODE_VERSION=$(node -p \"require('../package.json').engines.node\") -t ${BOOT_IMAGE:-infra-boot:dev} boot",
    "compose:generate": "tsx compose/synth.ts",
    "compose:check": "tsx compose/synth.ts --check",
    "engine-gate": "bash scripts/engine-gate.sh",
    "ts": "cd .. && tsgo -p infra/tsconfig.json --pretty",
    "tsperf": "rm -rf tsconfig.tsbuildinfo && tsgo --noEmit --extendedDiagnostics"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@inquirer/core": "^12.0.6",
    "@inquirer/prompts": "^8.7.5",
    "@pulumi/pulumi": "^3.272.0",
    "@pulumi/random": "^4.21.4",
    "@pulumiverse/scaleway": "^1.60.0",
    "picocolors": "^1.1.1",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "rolldown": "~1.2.15",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
