{
  "name": "infra",
  "description": "Pulumi program and CLI that set up and deploy the app on Scaleway",
  "type": "module",
  "scripts": {
    "cli": "tsx cli/infra-cli.ts",
    "builder-script": "tsx tasks/print-builder-script.ts",
    "test": "vitest run",
    "test:integration": "INTEGRATION=1 vitest run tests/integration",
    "ensure-state-bucket": "tsx tasks/ensure-state-bucket.ts",
    "deploy": "tsx tasks/deploy.ts",
    "main-job": "tsx tasks/main-job.ts",
    "description-hash": "tsx tasks/description-hash.ts",
    "status": "tsx tasks/status.ts",
    "repair-certs": "tsx tasks/repair-certs.ts",
    "agent:build": "rm -rf agent/dist && tsc --noEmit -p agent/tsconfig.json && rolldown agent/src/entry.ts --format cjs --platform node --file agent/dist/entry.cjs",
    "agent:image": "pnpm run agent:build && docker build --build-arg NODE_VERSION=$(node -p \"require('../package.json').engines.node\") -t ${AGENT_IMAGE:-infra-agent:dev} agent",
    "compose:generate": "tsx compose/synth.ts",
    "compose:check": "tsx compose/synth.ts --check",
    "ts": "cd .. && tsgo -p infra/tsconfig.json --pretty",
    "tsperf": "rm -rf tsconfig.tsbuildinfo && tsgo --noEmit --extendedDiagnostics"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@inquirer/core": "^12.0.6",
    "@inquirer/prompts": "^8.7.5",
    "@pulumi/pulumi": "^3.274.1",
    "@pulumiverse/scaleway": "^1.61.1",
    "picocolors": "^1.1.1",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "ajv": "^8.20.0",
    "rolldown": "~1.3.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
