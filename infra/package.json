{
  "name": "infra",
  "description": "The app's part of infra: its config, stack files and environment records, which the engine in @cellajs/cli deploys",
  "type": "module",
  "exports": {
    "./config/*": "./config/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "ts": "cd .. && tsgo -p infra/tsconfig.json --pretty",
    "main-job": "cella infra main-job",
    "deploy": "cella infra deploy",
    "description-hash": "cella infra description-hash",
    "privileged-footprint": "cella infra privileged-footprint",
    "privileged-check": "cella infra privileged-check",
    "release-applied-check": "cella infra release-applied-check",
    "builder-script": "cella infra builder-script",
    "compose:generate": "cella infra compose-generate",
    "compose:check": "cella infra compose-check",
    "ensure-state-bucket": "cella infra ensure-state-bucket",
    "repair-certs": "cella infra repair-certs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@cellajs/cli": "^0.10.0",
    "@pulumi/pulumi": "^3.277.0",
    "@pulumiverse/scaleway": "^1.62.1",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "vitest": "^5.1.1"
  }
}
