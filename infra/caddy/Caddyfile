# Caddyfile for the production `frontend` profile.
#
# This Caddy instance runs on its own machine (the backend's under singleVM)
# behind the load balancer and acts as the public origin for the SPA. The
# actual static bundle still lives in the frontend S3 bucket; Caddy
# reverse-proxies to it, adds security headers a bare S3 bucket cannot, and
# rewrites any 404 to /index.html so SPA deep links resolve.
#
# The CSP reaches the machine in its static env, which the deploy writes from
# the applied description: a CSP change goes live with the release that
# carries it, once the apply from its checkout ran.
#
# The image is rebuilt per release (see infra/caddy/Dockerfile) so that
# `RELEASE_SHA` is baked in and surfaces as `X-App-Version`, which the machine's
# agent reads before it passes the load balancer's check.
#
# Configurable env (set in infra/config/services.config.ts `frontend` entry):
#   RELEASE_SHA : bound to X-App-Version (defaulted to "dev" in Dockerfile)
#   ORIGIN_HOST : S3 REST hostname for the frontend bucket
{
	admin off
	auto_https off
	servers {
		protocols h1 h2
	}
}

:80 {
	log {
		output stderr
		format console
	}

	# S3 stores objects uncompressed, so compress proxied responses here.
	# Without this every asset (and the full SW precache) ships raw bytes.
	encode zstd gzip

	header {
		Content-Security-Policy "{$FRONTEND_CSP}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-App-Version "{$RELEASE_SHA}"
		-Server
	}

	# Health endpoint: the machine's agent probes this for the load balancer's check.
	# Returns 200 with X-App-Version from the outer header block above.
	handle /health {
		respond "ok" 200
	}

	# Long-cache versioned assets. The frontend build hashes filenames under
	# /assets/, so a year cache is safe there.
	#
	# Every Cache-Control below carries the `>` prefix, which sets the field with `defer`. An
	# unprefixed header runs before the reverse_proxy response arrives, so S3's own Cache-Control
	# (written as object metadata by tasks/frontend-assets.ts and tasks/deploy-run.ts) lands after
	# it and the response carries the field twice. Deferring makes these values replace it.
	@assets path /assets/*
	handle @assets {
		header >Cache-Control "public, max-age=31536000, immutable"

		# The build writes a brotli copy beside each script and stylesheet (`<file>.br`), smaller than what `encode`
		# makes per response. Its encoding is set on the upstream response whatever S3 stored, as that header is what
		# tells `encode` to leave the bytes alone. An asset of a release older than these copies has none, so a 404
		# falls back to the original, which `encode` compresses per response.
		@brotli {
			path *.js *.mjs *.css
			header Accept-Encoding *br*
		}
		handle @brotli {
			rewrite * {path}.br
			reverse_proxy https://{$ORIGIN_HOST} {
				header_up Host {$ORIGIN_HOST}
				header_down Content-Encoding br
				header_down Vary Accept-Encoding
				@nocopy status 404
				handle_response @nocopy {
					rewrite * {http.request.orig_uri.path}
					reverse_proxy https://{$ORIGIN_HOST} {
						header_up Host {$ORIGIN_HOST}
					}
				}
			}
		}

		handle {
			reverse_proxy https://{$ORIGIN_HOST} {
				header_up Host {$ORIGIN_HOST}
			}
		}
	}

	# /static/ keys keep stable names with changing content (docs.gen JSON,
	# openapi.json, flags), so never mark them immutable: a short cache plus the
	# ?v=<sha> param the app appends to mutable fetches keeps them fresh.
	@static path /static/*
	handle @static {
		header >Cache-Control "public, max-age=3600"
		reverse_proxy https://{$ORIGIN_HOST} {
			header_up Host {$ORIGIN_HOST}
		}
	}

	# OAuth metadata at the RFC 8414 and RFC 9728 location, the well-known name before the issuer or resource path, is
	# published under that path, which the load balancer routes to its service: the answer points there. The path must
	# start with a letter or digit, so the address stays on this origin.
	@oauthMetadata path_regexp oauthMetadata ^/\.well-known/(oauth-authorization-server|oauth-protected-resource)(/[a-z0-9].*)$
	handle @oauthMetadata {
		redir {re.oauthMetadata.2}/.well-known/{re.oauthMetadata.1} 307
	}

	# Probes read /.well-known/* (security.txt, agent catalogs, app links) as data, so a missing
	# file answers the origin's 404, never the index.html fallback with a 200.
	@wellKnown path /.well-known/*
	handle @wellKnown {
		reverse_proxy https://{$ORIGIN_HOST} {
			header_up Host {$ORIGIN_HOST}
		}
	}

	# Root path maps to an empty S3 object key, which the REST endpoint answers
	# with 403 (not 404), so the deep-link fallback below never triggers. Serve
	# index.html directly for "/".
	@root path /
	handle @root {
		header >Cache-Control "no-cache"
		rewrite * /index.html
		reverse_proxy https://{$ORIGIN_HOST} {
			header_up Host {$ORIGIN_HOST}
		}
	}

	# Default: proxy to S3; on a 404 from origin (deep link to a client-side
	# route), rewrite to /index.html and re-proxy so the SPA can take over.
	handle {
		header >Cache-Control "no-cache"
		reverse_proxy https://{$ORIGIN_HOST} {
			header_up Host {$ORIGIN_HOST}
			@notfound status 404
			handle_response @notfound {
				rewrite * /index.html
				reverse_proxy https://{$ORIGIN_HOST} {
					header_up Host {$ORIGIN_HOST}
				}
			}
		}
	}
}
