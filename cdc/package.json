{
  "name": "cdc-worker",
  "version": "0.0.1",
  "description": "PostgreSQL logical-replication worker for activity and sync events",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "node dist/cdc-worker.js",
    "start:dev": "tsx src/cdc-worker.ts",
    "dev": "cross-env NODE_ENV=development tsx --env-file=../backend/.env --watch src/cdc-worker.ts",
    "sync": "tsx --env-file=../backend/.env src/sync-request.ts",
    "build": "cross-env NODE_ENV=production tsup",
    "ts": "tsgo --pretty",
    "tsperf": "rm -rf tsconfig.tsbuildinfo && tsgo --noEmit --extendedDiagnostics",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "pg": "^8.23.1",
    "pg-logical-replication": "^2.5.0",
    "pino": "^10.4.0",
    "pino-opentelemetry-transport": "^4.0.2",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cross-env": "^10.1.0",
    "drizzle-orm": "1.0.0-rc.3",
    "hono": "^4.13.13",
    "sdk": "workspace:*",
    "shared": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
