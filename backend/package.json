{
  "name": "backend",
  "version": "0.0.1",
  "description": "Hono API server with postgres, auth, CRUD, and real-time sync",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx dist/main.js",
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --watch-path=src --watch-path=../shared/src --watch-path=../shared/config src/main.ts",
    "tunnel": "cross-env NODE_ENV=tunnel tsx --watch-path=src --watch-path=../shared/src --watch-path=../shared/config src/main.ts",
    "ts": "cd .. && tsgo -p backend/tsconfig.json --pretty",
    "tsperf": "rm -rf dist && rm -rf tsconfig.tsbuildinfo && tsgo --extendedDiagnostics",
    "build": "cross-env NODE_ENV=production rolldown -c",
    "build:dev": "rolldown -c",
    "build:staging": "cross-env NODE_ENV=staging rolldown -c",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "stop": "tsx scripts/stop-database.ts",
    "seed": "tsx scripts/seeds.ts",
    "migrate": "tsx scripts/migrate.ts",
    "jobs": "tsx scripts/jobs.ts",
    "generate:pg": "drizzle-kit generate --config drizzle.config.ts",
    "generate": "tsx scripts/generate.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio --config drizzle.config.ts",
    "test": "cross-env TEST_MODE=core vitest run",
    "test:runtime": "cross-env TEST_MODE=core TEST_DB_ROLE=runtime vitest run",
    "manual-migration": "tsx scripts/manual-migration.ts",
    "test:full": "cross-env TEST_MODE=full vitest run",
    "seed:production": "node dist/seeds-bundle.js",
    "s3:cors": "tsx scripts/set-bucket-cors.ts",
    "session:mint": "tsx scripts/mint-session.ts",
    "yjs:public-key": "tsx scripts/yjs-public-key.ts",
    "seed:assets": "tsx scripts/upload-seed-assets.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-abstract-transport": "^3.0.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@blocknote/core": "^0.56.0",
    "@faker-js/faker": "^10.6.0",
    "@hono/node-server": "^2.1.5",
    "@hono/otel": "^1.2.0",
    "@hono/zod-openapi": "^1.6.3",
    "@isaacs/ttlcache": "^2.1.5",
    "@simplewebauthn/server": "^14.0.3",
    "@t3-oss/env-core": "^0.13.11",
    "@types/node": "^26.6.5",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cdc-worker": "workspace:*",
    "cross-env": "^10.1.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.13",
    "i18next": "^26.5.4",
    "isbot": "^5.2.2",
    "jose": "^6.2.13",
    "maxmind": "^5.0.7",
    "nanoid": "^6.0.2",
    "oauth4webapi": "^3.8.8",
    "oidc-provider": "9.13.0",
    "ora": "^9.4.1",
    "pg-boss": "^12.38.0",
    "picocolors": "^1.1.1",
    "pino-pretty": "^13.2.0",
    "rate-limiter-flexible": "^11.2.3",
    "react": "^19.3.1",
    "rolldown": "~1.2.15",
    "sanitize-html": "^2.18.1",
    "sdk": "workspace:*",
    "shared": "workspace:*",
    "slugify": "^1.6.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "uuidv7": "^1.2.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "yjs-worker": "workspace:*",
    "zod": "^4.6.7"
  },
  "exports": {
    "types": "./dist/src/index.d.ts"
  },
  "types": "./dist/src/index.d.ts"
}
