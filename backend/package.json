{
  "name": "backend",
  "version": "0.0.1",
  "description": "Hono API server with postgres, auth, CRUD, and real-time sync",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production tsx dist/main.js",
    "dev": "cross-env NODE_ENV=development tsx --watch-path=src --watch-path=../shared/src --watch-path=../shared/config src/main.ts",
    "tunnel": "cross-env NODE_ENV=tunnel tsx --watch-path=src --watch-path=../shared/src --watch-path=../shared/config src/main.ts",
    "ts": "cd .. && tsgo -p backend/tsconfig.json --pretty",
    "tsperf": "rm -rf dist && rm -rf tsconfig.tsbuildinfo && tsgo --extendedDiagnostics",
    "build": "cross-env NODE_ENV=production tsup",
    "build:dev": "tsup",
    "build:staging": "cross-env NODE_ENV=staging tsup",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "stop": "pnpm docker:down",
    "seed": "tsx scripts/seeds.ts",
    "migrate": "tsx scripts/migrate.ts",
    "generate:pg": "drizzle-kit generate --config drizzle.config.ts",
    "generate": "tsx scripts/generate.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio --config drizzle.config.ts",
    "test": "cross-env TEST_MODE=core vitest run",
    "manual-migration": "tsx scripts/manual-migration.ts",
    "test:full": "cross-env TEST_MODE=full vitest run",
    "seed:production": "node dist/seeds-bundle.js",
    "geoip:download": "tsx scripts/download-geoip.ts",
    "s3:cors": "tsx scripts/set-bucket-cors.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "pg-format": "^1.0.4",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "pino-pretty": "^13.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@ag-ui/core": "^0.0.59",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@blocknote/core": "^0.54.0",
    "@blocknote/server-util": "^0.54.0",
    "@commander-js/extra-typings": "^15.0.0",
    "@dotenv-run/core": "^1.3.8",
    "@faker-js/faker": "^10.6.0",
    "@getbrevo/brevo": "^6.0.3",
    "@hono/node-server": "^2.1.1",
    "@hono/otel": "^1.1.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@hono/zod-openapi": "^1.6.1",
    "@isaacs/ttlcache": "^2.1.5",
    "@napi-rs/canvas": "^1.0.8",
    "@ngrok/ngrok": "^1.7.0",
    "@oslojs/encoding": "^1.1.0",
    "@simplewebauthn/server": "^13.3.3",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/ai": "^0.52.0",
    "@types/hast": "^3.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "26.4.0",
    "@types/pg": "^8.23.1",
    "@types/pg-format": "^1.0.5",
    "@types/react": "19.2.18",
    "@types/sanitize-html": "^2.16.1",
    "@types/ua-parser-js": "^0.7.39",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cdc-worker": "workspace:*",
    "commander": "^15.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.3",
    "enforce-unique": "^1.3.0",
    "hono": "^4.13.5",
    "html-to-text": "^10.0.1",
    "i18next": "^26.4.0",
    "isbot": "^5.2.2",
    "lru-cache": "^11.5.2",
    "maxmind": "^5.0.7",
    "nanoid": "^6.0.1",
    "oauth4webapi": "^3.8.7",
    "openai": "^7.8.0",
    "ora": "^9.4.1",
    "pg-boss": "^12.29.0",
    "pg-logical-replication": "^2.5.0",
    "picocolors": "^1.1.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype": "^13.0.2",
    "rehype-stringify": "^10.0.1",
    "sanitize-html": "^2.17.7",
    "sdk": "workspace:*",
    "shared": "workspace:*",
    "slugify": "^1.6.9",
    "transloadit": "4.11.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "ua-parser-js": "^2.0.10",
    "uuidv7": "^1.2.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3",
    "yjs-worker": "workspace:*",
    "zod": "^4.5.4"
  },
  "exports": {
    "types": "./dist/src/index.d.ts"
  },
  "types": "./dist/src/index.d.ts"
}
