{
  "name": "backend",
  "version": "0.0.1",
  "description": "Hono API server with postgres, auth, CRUD, and real-time sync",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --watch-path=src --watch-path=../shared/src --watch-path=../shared/config src/main.ts",
    "dev:mcp": "cross-env SERVICE=mcp NODE_ENV=development NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --watch-path=src --watch-path=../shared/src --watch-path=../shared/config src/main.ts",
    "dev:oauth": "cross-env SERVICE=oauth NODE_ENV=development NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --watch-path=src --watch-path=../shared/src --watch-path=../shared/config src/main.ts",
    "dev:jobs": "cross-env SERVICE=jobs NODE_ENV=development NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --watch-path=src --watch-path=../shared/src --watch-path=../shared/config src/main.ts",
    "ts": "cd .. && tsgo -p backend/tsconfig.json --pretty",
    "tsperf": "rm -rf dist && rm -rf tsconfig.tsbuildinfo && tsgo --extendedDiagnostics",
    "build": "cross-env NODE_ENV=production rolldown -c",
    "stop": "tsx scripts/stop-database.ts",
    "seed": "tsx scripts/seeds.ts",
    "bench:seed": "tsx bench/data-setup.ts",
    "bench:teardown": "tsx bench/data-setup.ts --teardown",
    "migrate": "tsx scripts/migrate.ts",
    "generate": "tsx scripts/generate.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "studio": "tsx scripts/drizzle-studio/start.ts",
    "test": "cross-env TEST_MODE=core vitest run",
    "s3:cors": "tsx scripts/set-bucket-cors.ts",
    "session:mint": "tsx scripts/mint-session.ts",
    "yjs:public-key": "tsx scripts/yjs-public-key.ts",
    "seed:assets": "tsx scripts/upload-seed-assets.ts",
    "compose": "tsx scripts/docker-compose.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation": "^0.301.1",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-abstract-transport": "^3.0.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@blocknote/core": "^0.57.0",
    "@faker-js/faker": "^10.6.0",
    "@hono/node-server": "^2.1.7",
    "@hono/otel": "^1.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@isaacs/ttlcache": "^2.1.5",
    "@simplewebauthn/server": "^14.1.0",
    "@types/node": "^26.6.6",
    "@types/oidc-provider": "^9.13.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cdc-worker": "workspace:*",
    "cross-env": "^10.1.0",
    "domhandler": "^6.0.1",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.18",
    "htmlparser2": "^12.0.0",
    "i18next": "^27.1.1",
    "isbot": "^5.2.3",
    "jose": "^6.2.17",
    "lib0": "^0.2.120",
    "maxmind": "^5.0.8",
    "nanoid": "^6.0.2",
    "oauth4webapi": "^3.8.8",
    "oidc-provider": "^9.14.0",
    "ora": "^10.0.0",
    "pg-boss": "^12.38.2",
    "picocolors": "^1.1.1",
    "pino-pretty": "^13.2.0",
    "rate-limiter-flexible": "^11.4.1",
    "react": "^19.3.1",
    "rolldown": "~1.3.2",
    "sanitize-html": "^2.18.2",
    "sdk": "workspace:*",
    "shared": "workspace:*",
    "slugify": "^1.6.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "uuidv7": "^1.2.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "web-push": "^4.0.0",
    "ws": "^8.22.2",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "yjs-worker": "workspace:*",
    "zod": "^4.6.7"
  },
  "exports": {
    "types": "./dist/src/index.d.ts"
  },
  "types": "./dist/src/index.d.ts"
}
