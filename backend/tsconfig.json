{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Backend and shared only: the frontend has pre-existing implicit returns to clean up first.
    "noImplicitOverride": true,
    "noImplicitReturns": true,

    "allowImportingTsExtensions": true,

    "lib": ["es2024", "DOM", "DOM.Iterable"],

    "rootDir": "../",
    "sourceMap": true,
    "inlineSources": true,

    // Set `sourceRoot` to  "/" to strip the build path prefix
    // from generated source code references.
    // This improves issue grouping in Sentry.
    "sourceRoot": "/",

    "paths": {
      "#/*": ["./src/*"],
      "#json/*": ["../json/*"],
    },
  },
  "include": ["src/**/*", "drizzle.config.ts", "emails", "../shared/*", "../json/*", "../locales/*",  "tests", "scripts", "trigger.config.ts", "../shared/*", "../cdc/src/**/*", "../mcp/src/**/*"],
  "exclude": ["**/node_modules", "**/dist", "**/.*/"]
}
